# Variables de entorno del build (Vite expone sólo las que empiezan con VITE_).
# Copiar a .env.local para desarrollo; en Vercel se cargan en Project Settings → Environment Variables.

# URL base de los .ttf de Gilroy (no se versionan: tipografía con licencia).
# En local queda vacía y se usan los archivos de public/fonts/. En Vercel, la URL donde estén alojadas.
VITE_FONTS_BASE_URL=
